{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Song Practice Studio",
  "version": "0.0.37",
  "identifier": "com.songpracticestudio.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5183",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Song Practice Studio",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "maximized": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/.songpracticestudio/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/song-practice-studio-sidecar"
    ],
    "resources": [
      "resources/third-party-notices/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU2NDc0NTlCMUNCN0QzQjIKUldTeTA3Y2NtMFZINWtFSFlxZ3ROaVJ6QVB0RlRJTXRYVng1Tk9KbjlKWVVwRWJzUEpDUGdYNGwK",
      "endpoints": [
        "https://github.com/giamat90/SongPracticeStudio/releases/latest/download/latest.json"
      ]
    }
  }
}
